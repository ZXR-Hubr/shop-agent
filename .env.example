# ===== LLM 配置（任何 OpenAI 兼容接口都可以）=====
# 阿里云百炼（DashScope 兼容模式）—— 项目默认
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus        # 可选 qwen-max / qwen-turbo
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# OpenAI 示例：
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini

LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 不填 Key 时自动进入 Mock 模式：无需联网即可体验完整的工具调用流程。
# 需要强制 Mock 时设为 1。
# LLM_MOCK=1

# 可选：向量化模型（不填则使用内置本地向量化，零依赖）
# EMBED_MODEL=text-embedding-v3

# 可选：Redis 会话存储（不填则使用进程内内存）
# 填了会真实使用 Redis 共享会话；没装 redis 库或服务连不上会自动降级到内存。
# REDIS_URL=redis://127.0.0.1:6379/0

# 可选：向量库后端 local / pgvector / milvus（默认 local，零依赖）
# local    = 进程内余弦检索，开箱即跑
# pgvector = PostgreSQL + pgvector 扩展；需先建库并 CREATE EXTENSION vector
# milvus   = Milvus 向量数据库（COSINE 度量）
# 连接失败时自动降级回 local，不影响演示。
# VECTOR_BACKEND=local
#   pgvector 连接参数（也可直接用 PG_DSN 一次性给出）
# PG_DSN=postgresql://postgres:密码@127.0.0.1:5432/shop_agent
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=
# PG_DATABASE=shop_agent
#   milvus 连接参数
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_TOKEN=
# MILVUS_COLLECTION=shop_agent_kb

# 可选：Agent 编排框架 native / langchain（默认 native 手写循环）
# langchain 需装 langchain + langchain-openai 且有真实 API Key；
# Mock 模式或缺依赖时自动回退 native。
# AGENT_FRAMEWORK=native

# Web 框架：默认 FastAPI（uvicorn app.main:app），另有 Flask 入口：python flask_app.py（8001 端口）

# ===== MySQL 数据源（商品 / 订单 / 知识库 / 售后工单）=====
# 开启后工具优先读 MySQL；未开启或连接失败自动回退到 data/*.json。
# 首次使用先运行：.venv\Scripts\python.exe db\init_db.py 建库导数据。
MYSQL_ENABLED=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=xiaoman_shop

# 可选：调参
# TEMPERATURE=0.3
# MAX_TOOL_ROUNDS=5
# MAX_HISTORY=20
# SESSION_TTL=3600

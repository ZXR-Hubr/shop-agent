# ===== LLM 配置（任何 OpenAI 兼容接口都可以）=====
# 阿里云百炼（DashScope 兼容模式）—— 项目默认
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus        # 可选 qwen-max / qwen-turbo
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# OpenAI 示例：
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini

LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 不填 Key 时自动进入 Mock 模式：无需联网即可体验完整的工具调用流程。
# 需要强制 Mock 时设为 1。
# LLM_MOCK=1

# 可选：向量化模型（不填则使用内置本地向量化，零依赖）
# EMBED_MODEL=text-embedding-v3

# 可选：Redis 会话存储（不填则使用进程内内存）
# REDIS_URL=redis://127.0.0.1:6379/0

# ===== MySQL 数据源（商品 / 订单 / 知识库 / 售后工单）=====
# 开启后工具优先读 MySQL；未开启或连接失败自动回退到 data/*.json。
# 首次使用先运行：.venv\Scripts\python.exe db\init_db.py 建库导数据。
MYSQL_ENABLED=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=xiaoman_shop

# 可选：调参
# TEMPERATURE=0.3
# MAX_TOOL_ROUNDS=5
# MAX_HISTORY=20
# SESSION_TTL=3600
